# ─────────────────────────────────────────────────────────────────────────
# LJFC environment
#
#   cp .env.example .env.local     then fill in the values
#
# .env.local is gitignored and LOCAL ONLY — production reads its own values
# from the Vercel dashboard, so editing this file never affects the live site.
#
# ⚠️  READ THIS BEFORE RUNNING npm run dev
#
# The .env.local currently on this machine points at the PRODUCTION Supabase
# project with the service-role key, and at LIVE Stripe. That means local dev
# reads and writes real student records, and a click through checkout creates
# a real Stripe session. `npm run dev` runs scripts/check-env.mjs first and
# will tell you which of these apply.
#
# The safe setup is a second Supabase project for development. See the
# "Local development" section of CLAUDE.md.
# ─────────────────────────────────────────────────────────────────────────


# ── Supabase ─────────────────────────────────────────────────────────────
# Production project ref is bvfxmqysquthijsntbnh. Use a DIFFERENT project
# here for local development. Seed it from supabase/core-schema.sql plus the
# other files in supabase/.
#
# The service-role key bypasses row-level security entirely. Server-side only
# — never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Not currently referenced anywhere in src/ — the app only ever talks to
# Supabase server-side with the service-role key. Kept for future client-side
# use; safe to leave blank.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── Stripe ───────────────────────────────────────────────────────────────
# ⚠️  STRIPE_MODE is read by /api/invoice ONLY. /api/checkout and the webhook
#     use STRIPE_SECRET_KEY unconditionally, so setting STRIPE_MODE=test does
#     NOT make checkout safe. For local work, put an sk_test_ key in
#     STRIPE_SECRET_KEY itself.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_MODE=test

# Signing secret for /api/webhook/stripe. If unset the route falls back to
# parsing the body unverified — fine locally, required in production.
STRIPE_WEBHOOK_SECRET=

# Not currently referenced in src/ — checkout is a server-side redirect to
# Stripe Checkout, so there is no client-side Stripe.js. Safe to leave blank.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=


# ── Email ────────────────────────────────────────────────────────────────
# Deliberately absent from local .env.local. Without RESEND_API_KEY the send
# routes return "not configured" instead of mailing real students, which is
# the behaviour you want locally. Only set this if you are specifically
# testing email, and point it at a Resend test audience.
RESEND_API_KEY=

# Kit/ConvertKit broadcasts — daily conditions and the Saturday blast.
# v4 uses KIT_API_KEY; KIT_API_SECRET is the v3 fallback. Leave both unset
# locally unless testing broadcasts: these send to the real subscriber list.
KIT_API_KEY=
KIT_API_SECRET=


# ── Other services ───────────────────────────────────────────────────────
# Used by /api/visibility (Scripps cam read), the inquiry reply drafter,
# and inquiry fact extraction (src/lib/extractInquiryFacts.ts). Optional
# locally — visibility falls back to its predictive model, extraction
# quietly skips, the drafter reports "not configured".
ANTHROPIC_API_KEY=

# Joshua's personal Google Calendars, comma-separated "secret address in
# iCal format" URLs (Google Calendar → Settings → [calendar] → Integrate).
# The digest and reply drafter overlay these as busy blocks when suggesting
# course dates (src/lib/schedule.ts). Optional — unset means no overlay.
# Read-only; revoke any time by resetting the secret address in Google.
PERSONAL_ICS_URLS=

# Gmail IMAP sync (src/lib/gmailSync.ts): reconciles the inquiry pipeline
# with a Gmail inbox — marks inquiries replied when Joshua answered from
# Gmail, and flags student emails waiting on him. GMAIL_APP_PASSWORD is a
# Google App Password (myaccount.google.com/apppasswords, requires 2FA),
# NOT the account password; spaces in the pasted value are fine. Revoke
# from the same Google page. Optional — unset disables the sync.
# GMAIL_ALIASES: comma-separated "Send mail as" addresses on that account
# (e.g. joshua@lajollafreediveclub.com) so replies sent under an alias
# still count as outbound.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_ALIASES=

# The dedicated business mailbox (lajollafreediveclub@gmail.com). When set:
# inquiry notifications + student reply-tos + reply BCCs route here instead
# of Joshua's personal address, and the digest is delivered to both during
# the transition. Point GMAIL_USER at this account once it's home base.
BUSINESS_EMAIL=

# Authorises the five Vercel cron endpoints (src/lib/adminAuth.ts).
CRON_SECRET=

# ── Admin ────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Authorises every /api/admin/* route and the admin
# pages' sign-in. Auth FAILS CLOSED — with this unset nothing authenticates
# and the admin cockpit is locked, which is the safe default but will lock
# you out too. Set it in the Vercel dashboard before deploying.
#
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Rotating it invalidates existing sessions (the cookie is an HMAC of it).
ADMIN_KEY=

# Shared access code for the /students coach portal's STUDENT role — lets a
# student read and write their OWN dive logs via ?student=<name>. The coach
# role uses ADMIN_KEY instead, so this never unlocks everyone's logs.
#
# Also fails closed: unset means the student role cannot sign in. The coach
# role keeps working regardless, so leaving this blank is a valid choice if
# only Joshua uses that page.
#
# Weak by design — it is shared across students, which is what the page always
# did. It is now an env var rather than a string in the JS bundle.
STUDENT_CODE=

# Shared code for the invite-only strategy pages — /science, /ohpc, /ohpc/plan,
# /education, /research, /camp-garibaldi/charter-funding. Verified server-side
# (POST /api/gate, throttled) and exchanged for a 30-day httpOnly cookie; the
# page body never reaches an unauthorized browser. Comparison is trimmed and
# case-insensitive, matching the old client gate partners are used to.
#
# Fails closed: unset means the code path rejects everyone — but an admin
# session (ADMIN_KEY) always opens these pages, so Joshua is never locked out.
GATE_CODE=


# ── Not configurable ─────────────────────────────────────────────────────
# GA4 (G-X0ZXTHKTKK) is hardcoded in src/app/layout.tsx, not read from env.
# Formspree (mojknqlk) and the Google Apps Script endpoints are hardcoded in
# their routes. Noted here so the list of externals is complete.
